# Buildroot options for this plugin's ffmpeg (tools/build_ffmpeg.sh adds
# them to a Kiln OS Buildroot output): only what moonraker-timelapse uses.
# Rendering: JPEG frames (image2 + mjpeg) -> H.264 (libx264) in MP4, with
# its rotate/flip filters; the preview image is written back as JPEG.
BR2_PACKAGE_X264=y
BR2_PACKAGE_FFMPEG=y
BR2_PACKAGE_FFMPEG_GPL=y
BR2_PACKAGE_FFMPEG_FFMPEG=y
BR2_PACKAGE_FFMPEG_SWSCALE=y
BR2_PACKAGE_FFMPEG_ENCODERS="libx264 mjpeg"
BR2_PACKAGE_FFMPEG_DECODERS="mjpeg"
BR2_PACKAGE_FFMPEG_MUXERS="mp4 image2"
BR2_PACKAGE_FFMPEG_DEMUXERS="image2"
BR2_PACKAGE_FFMPEG_PARSERS="mjpeg"
BR2_PACKAGE_FFMPEG_BSFS=""
BR2_PACKAGE_FFMPEG_PROTOCOLS="file pipe"
BR2_PACKAGE_FFMPEG_FILTERS="transpose hflip vflip rotate scale format null copy setpts fps"
# BR2_PACKAGE_FFMPEG_INDEVS is not set
# BR2_PACKAGE_FFMPEG_OUTDEVS is not set
BR2_PACKAGE_FFMPEG_EXTRACONF="--disable-doc --disable-network --disable-iconv"
